/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "postpic-firewall",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-23",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	/**
	 * 唯一数据源：R2 存储桶。Worker 只读不写。
	 * 静态资源绑定（assets）已移除 —— 保留它会让 public/ 下的文件在 Worker 之前
	 * 被直接输出，形成一条绕过清洗的通道。所有路径都必须过清洗后再交给 R2。
	 */
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "postpic"
		}
	],

	/**
	 * 自定义域。若 postpic.iicemeta.com 当前绑在 R2 桶的 Public Access 上，
	 * 需先在 R2 侧解绑，否则 deploy 会报域名已被占用。
	 */
	"routes": [
		{
			"pattern": "postpic.iicemeta.com",
			"custom_domain": true
		}
	],

	"vars": {
		/* 键策略 */
		"ALLOWED_EXTENSIONS": "jpg,jpeg,jpe,png,webp,avif,gif,apng,ico,svg,bmp,tif,tiff,heic,heif,jxl,mp4,webm,mov,m4v,mp3,m4a,ogg,opus,wav,flac,pdf,json,txt,woff,woff2",
		"ENFORCE_EXTENSION": "false",
		"ALLOW_DOTFILES": "false",
		"KEY_MAX_LENGTH": "1024",
		"SEGMENT_MAX_LENGTH": "255",

		/* 热链防护：允许的主机及其子域放行，无 Referer 放行；cross-site 的 Sec-Fetch-Site 视为盗链 */
		"HOTLINK_MODE": "block",
		"HOTLINK_STRICT": "false",
		"ALLOWED_REFERER_HOSTS": "postpic.iicemeta.com,iicemeta.com",
		"ALLOWED_ORIGIN_HOSTS": "postpic.iicemeta.com,iicemeta.com",
		"CORP": "same-site",

		/*
		 * 限流：一篇文章没有懒加载，首屏会并发拉 40-50 张图，冷缓存下每张 4 点 = 200 点，
		 * 所以 burst 必须远大于 200，否则首屏会被自己限流打成一片破图。
		 */
		"RATE_LIMIT_MODE": "on",
		"RATE_LIMIT_RPS": "40",
		"RATE_LIMIT_BURST": "800",

		/*
		 * 新键配额：真正挡遍历的是这一层。同名覆盖的 image.png 命名可预测，
		 * 遍历 image-1..image-5000 成本极低，但正常访客一分钟也翻不到 600 个新键。
		 */
		"NOVELTY_MODE": "on",
		"NOVELTY_WINDOW_SECONDS": "60",
		"NOVELTY_MAX_KEYS": "600",

		/* 缓存：对象名不带内容 hash 且会被同名覆盖，1 小时 TTL + SWR，换图不用等一周 */
		"CDN_CACHE_SECONDS": "3600",
		"IMMUTABLE": "false",
		"STALE_WHILE_REVALIDATE_SECONDS": "86400",
		"NOT_FOUND_CACHE_SECONDS": "60",
		"MAX_CACHE_BYTES": "33554432",

		/* Range 分片 */
		"ALLOW_RANGE": "true"
	}

	/**
	 * URL 签名（可选，最强的一层）。启用：
	 *   npx wrangler secret put URL_SIGNING_SECRET
	 * 设置后所有请求必须带 ?exp=<unix秒>&sig=<hmac>，用 scripts/sign-url.mjs 生成。
	 * 密钥走 secret，不要写进 vars。
	 */
}
